# ============================================================
# VCF Generator Advance — server-side AI scanning
#
# Set these in your host's ENVIRONMENT VARIABLES panel
# (Vercel: Project -> Settings -> Environment Variables).
# NEVER commit real keys to the repo — this file is only a template.
#
# You need AT LEAST ONE key. Providers are tried in order and the
# first that answers wins, so adding more just buys resilience.
# ============================================================

# --- Groq: fastest, generous free tier (console.groq.com) ---
GROQ_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Google Gemini: strong vision, free tier (aistudio.google.com) ---
GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash

# --- OpenAI (platform.openai.com) ---
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- Anthropic Claude: best on messy/stylised cards (console.anthropic.com) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5

# --- Optional ---
# Try providers in this order instead of the default groq,gemini,openai,anthropic
# AI_PROVIDER_ORDER=gemini,groq

# Scans allowed per IP per hour. 0 disables the limit. Default 20.
# RATE_LIMIT_PER_HOUR=20
